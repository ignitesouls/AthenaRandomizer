<Window x:Class="Athena.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Athena"
        Height="280"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock TextWrapping="Wrap"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,0">
                Athena Randomizer
            </TextBlock>

            <TextBlock FontSize="10" TextAlignment="Center" Margin="0,0,0,10">
                An Elden Ring bingo mod by and for players.<LineBreak/>
                <Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl-3.0-standalone.html" RequestNavigate="Hyperlink_RequestNavigate">
                    Licensed under GPL 3.0.
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="Created by:" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>

            <!-- Replace each StackPanel of hyperlinks with a UniformGrid -->

            <!-- First row of creators -->
            <Grid HorizontalAlignment="Center" Margin="0,5,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/psiphicode" RequestNavigate="Hyperlink_RequestNavigate">Psiphi</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/rambler_ing" RequestNavigate="Hyperlink_RequestNavigate">Rambler</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/hoozher" RequestNavigate="Hyperlink_RequestNavigate">HooZher</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/cronys02" RequestNavigate="Hyperlink_RequestNavigate">Cronys</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/harvsouls" RequestNavigate="Hyperlink_RequestNavigate">Harv</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/elymis" RequestNavigate="Hyperlink_RequestNavigate">Ellie</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/nexusupnext" RequestNavigate="Hyperlink_RequestNavigate">Nexus</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="3" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/nartock_" RequestNavigate="Hyperlink_RequestNavigate">Nartock</Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/itsshura" RequestNavigate="Hyperlink_RequestNavigate">Shura</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/lazyhelios" RequestNavigate="Hyperlink_RequestNavigate">Helios</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="2" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://twitch.tv/sprklmouse" RequestNavigate="Hyperlink_RequestNavigate">Sprklmouse</Hyperlink>
                </TextBlock>


            </Grid>

            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                <Run Text="Brought to you by the Ignite community." />
                <LineBreak/>
                <Run Text="Join to play bingo!" />
                <LineBreak/>
                <Hyperlink NavigateUri="https://discord.gg/ignitesouls" RequestNavigate="Hyperlink_RequestNavigate">
                    discord.gg/ignitesouls
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
