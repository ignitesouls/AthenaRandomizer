<UserControl x:Class="Athena.Views.TabControlDlc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Athena.Converters"
             xmlns:services="clr-namespace:Athena.Services"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             >

    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="8" HorizontalAlignment="Center" MaxWidth="600">
        <TextBlock Text="SCADUBINGO Equipment Randomizer"
               FontSize="20"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <!-- Starlight Shop Weapons displayed horizontally -->
        <StackPanel Orientation="Vertical"
            HorizontalAlignment="Center"
            Margin="0,0,0,10"
            MaxWidth="600"
            Visibility="{Binding HasWeapons, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Starlight Shop Weapons:" 
               FontWeight="Bold"
               HorizontalAlignment="Center"
               FontSize="11"
               Margin="0,0,0,2"/>
            <ScrollViewer MaxHeight="30" 
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding WeaponsDisplayText}" 
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="9"
                   Padding="2"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Orientation="Vertical"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,0">
            <TextBlock Text="Base Seed:" Margin="0,0,0,2" />
            <TextBox Text="{Binding BaseSeedInput, UpdateSourceTrigger=PropertyChanged}" Width="120" />
        </StackPanel>

        <Button Content="Randomize"
            Height="40" Width="120"
            Margin="0,8,0,0"
            IsEnabled="True"
            Command="{Binding RandomizeCommand}"/>

        <Button Content="Launch Elden Ring"
            Height="40" Width="120"
            Margin="0,8,0,0"
            Command="{Binding LaunchCommand}"/>

        <GroupBox Header="DLC Mode"
          Margin="0,5,0,0"
          Padding="5"
          BorderBrush="LightGray"
          BorderThickness="1"
          HorizontalAlignment="Center"
          Width="250">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" Grid.Column="0" 
                     Content="Original"
                     Margin="3"
                     FontSize="11"
                     GroupName="DlcModeGroup"
                     IsChecked="{Binding DlcMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static services:DlcMode.Default}}" />

                <RadioButton Grid.Row="0" Grid.Column="1" 
                     Content="Moonwalk"
                     Margin="3"
                     FontSize="11"
                     GroupName="DlcModeGroup"
                     IsChecked="{Binding DlcMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static services:DlcMode.Moonwalk}}" />

                <RadioButton Grid.Row="1" Grid.Column="0" 
                     Content="Omenveil"
                     Margin="3"
                     FontSize="11"
                     GroupName="DlcModeGroup"
                     IsChecked="{Binding DlcMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static services:DlcMode.Omenveil}}" />

                <RadioButton Grid.Row="1" Grid.Column="1" 
                     Content="Anamnesis"
                     Margin="3"
                     FontSize="11"
                     GroupName="DlcModeGroup"
                     IsChecked="{Binding DlcMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static services:DlcMode.Anamnesis}}" />

                <RadioButton Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                     Content="Elden Squares"
                     Margin="3"
                     FontSize="11"
                     GroupName="DlcModeGroup"
                     IsChecked="{Binding DlcMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static services:DlcMode.Eldensquares}}" />
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>
