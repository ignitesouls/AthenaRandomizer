<UserControl x:Class="Athena.Views.TabControlBaseDlc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Athena.Converters"
             xmlns:services="clr-namespace:Athena.Services"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600">

    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="8"
                HorizontalAlignment="Center"
                MaxWidth="600">

        <TextBlock Text="Base + DLC Equipment Randomizer"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Randomized Graces displayed horizontally -->
        <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        MaxWidth="600"
                        Visibility="{Binding HasRandomizedGraces, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock Text="Randomized Graces:"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Margin="0,0,0,2"/>

            <ScrollViewer MaxHeight="30"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                <TextBlock Text="{Binding RandomizedGracesDisplayText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Padding="2"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0">

            <TextBlock Text="Base Seed:"
                       Margin="0,0,0,2" />

            <TextBox Text="{Binding BaseSeedInput, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" />
        </StackPanel>

        <Button Content="Randomize"
                Height="40"
                Width="120"
                Margin="0,8,0,0"
                IsEnabled="True"
                Command="{Binding RandomizeCommand}"/>

        <Button Content="Launch Elden Ring"
                Height="40"
                Width="120"
                Margin="0,8,0,0"
                Command="{Binding LaunchCommand}"/>

        <GroupBox Header="Base + DLC Mode"
                  Margin="0,5,0,0"
                  Padding="5"
                  BorderBrush="LightGray"
                  BorderThickness="1"
                  HorizontalAlignment="Center"
                  Width="250">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0"
                             Grid.Column="0"
                             Content="Regular"
                             Margin="3"
                             FontSize="11"
                             GroupName="BaseDlcModeGroup"
                             IsChecked="{Binding BaseDlcMode,
                                                 Converter={StaticResource EnumToBooleanConverter},
                                                 ConverterParameter={x:Static services:BaseDlcMode.Default}}" />

                <RadioButton Grid.Row="0"
                             Grid.Column="1"
                             Content="VCC"
                             Margin="3"
                             FontSize="11"
                             GroupName="BaseDlcModeGroup"
                             IsChecked="{Binding BaseDlcMode,
                                                 Converter={StaticResource EnumToBooleanConverter},
                                                 ConverterParameter={x:Static services:BaseDlcMode.VCC}}" />
            </Grid>
        </GroupBox>

    </StackPanel>
</UserControl>